{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kompose.invalid/schemas/kristal.schema.json",
  "title": "KOMPOSE kristal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "status",
    "perspective",
    "sources",
    "editorial_review",
    "topics"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "published",
        "retired",
        "demo"
      ]
    },
    "perspective": {
      "type": "object",
      "required": [
        "type",
        "attribution",
        "period",
        "territory",
        "context"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "archives_coloniales",
            "nation_autochtone_identifiee",
            "analyse_methodologique",
            "autre"
          ]
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "territory": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "community_permission_required": {
          "type": "boolean"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "provenance",
          "verified",
          "rights_cleared"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          },
          "verified": {
            "type": "boolean"
          },
          "rights_cleared": {
            "type": "boolean"
          },
          "citation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "editorial_review": {
      "type": "object",
      "required": [
        "status",
        "reviewer_ref"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "reviewer_ref": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "community_review_status": {
          "type": "string",
          "enum": [
            "not_applicable",
            "pending",
            "approved",
            "rejected"
          ]
        }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "questions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "answer",
                "source_refs",
                "limitations"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "answer": {
                  "type": "string",
                  "minLength": 1
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "limitations": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
